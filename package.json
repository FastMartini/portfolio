{
  "name": "diego-martinez-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preview:hero": "NEXT_PUBLIC_BASE_PATH=/portfolio next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "build:test": "next build",
    "lint": "eslint .",
    "social:generate": "node scripts/generate-social-images.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:contact-delivery": "TEST_WEB3FORMS_KEY=00000000-0000-4000-8000-000000000000 playwright test tests/summit-delivery.spec.ts",
    "theme:generate": "node scripts/generate-theme-css.mjs",
    "splash:generate": "node scripts/generate-splash-motion.mjs && node scripts/rasterize-splash-print.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.7",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
